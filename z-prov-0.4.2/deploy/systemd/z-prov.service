[Unit]
Description=Z-Prov Multi-Provider AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=Z_PROV_CONFIG=@CONFIG@
Environment=Z_PROV_HOST=127.0.0.1
Environment=Z_PROV_PORT=8080
EnvironmentFile=-%h/.config/z-prov/environment
ExecStart=@BIN@
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
