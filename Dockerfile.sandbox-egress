FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --gid 65532 zeaz-egress && \
    useradd --uid 65532 --gid zeaz-egress --shell /usr/sbin/nologin --no-create-home zeaz-egress
WORKDIR /app
COPY --chown=65532:65532 packages/zeaz-sandbox/src/zeaz_sandbox/egress_proxy.py /app/egress_proxy.py
USER 65532:65532
ENTRYPOINT ["python", "/app/egress_proxy.py"]
