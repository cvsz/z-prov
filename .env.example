ZEAZ_CLIENT_KEYS=replace-with-generated-client-key
# Preferred for production. Values are comma-separated sha256:<hex> digests.
ZEAZ_CLIENT_KEY_HASHES=
ZEAZ_CONFIG=/app/config/providers.yaml
ZEAZ_HOST=0.0.0.0
ZEAZ_PORT=8080
ZEAZ_WORKERS=1
ZEAZ_MAX_REQUEST_BYTES=4194304
ZEAZ_MAX_OUTPUT_TOKENS=131072
ZEAZ_MAX_RESPONSE_BYTES=16777216
ZEAZ_MAX_CONCURRENT_REQUESTS=100
ZEAZ_METRICS_ENABLED=true
# Optional OTLP/HTTP metrics export. Leave empty to disable.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
ZEAZ_RATE_LIMIT_BACKEND=memory
# Required only when ZEAZ_RATE_LIMIT_BACKEND=redis.
ZEAZ_REDIS_URL=
ZEAZ_RATE_LIMIT_KEY_PREFIX=zeaz:rate-limit:
# Empty by default: CF-Connecting-IP is ignored unless the direct peer matches.
ZEAZ_TRUSTED_PROXY_CIDRS=
ZEAZ_LOCAL_MODEL=qwen3:8b

# Disabled by default because external fallback sends request content to cloud.
FREE_CLOUD_FALLBACK_ENABLED=false
OPENROUTER_FREE_MODEL=openrouter/free
GEMINI_FREE_MODEL=gemini-2.5-flash-lite
GROQ_FREE_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_API_KEY=
PERPLEXITY_API_KEY=

CUSTOM_PROVIDER_ENABLED=false
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
