[Unit]
Description=ZeaZ Multi-Provider AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ZEAZ_CONFIG=@CONFIG@
Environment=ZEAZ_HOST=127.0.0.1
Environment=ZEAZ_PORT=8080
EnvironmentFile=-%h/.config/zeaz-provider/environment
ExecStart=@BIN@
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
